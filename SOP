let SETT;
function settingsInput(el) { const k = el.dataset.set; DB[k] = el.value.trim(); if (k === 'unit') DB.packDirty = true; clearTimeout(SETT); SETT = setTimeout(save, 300); }

/* ---------- 動作 ---------- */
const ACT = {
  lock() { setAdmin(false); const r = route(); EDIT = null; if (r.name === 'edit' || r.name === 'review') location.hash = '#/'; render(); toast('已鎖定管理模式'); },
  newTask() { location.hash = '#/edit/new'; },

  async adminEnter() {
    if (!DB.pinHash) {
      const v = await dlg({ title: '設定管理密碼', msg: '4～8 位數字。之後修改SOP都要輸入這組密碼，請記好；忘記了沒辦法找回。',
        fields: [{ key: 'a', label: '管理密碼', type: 'password', mode: 'numeric', req: true }, { key: 'b', label: '再輸入一次', type: 'password', mode: 'numeric', req: true }],
        validate: v => !/^\d{4,8}$/.test(v.a) ? '請輸入 4～8 位數字' : v.a !== v.b ? '兩次輸入的密碼不一樣' : '', ok: '設定並進入' });
      if (!v) return;
      DB.pinHash = pinHash(v.a); save(); setAdmin(true); render(); toast('已進入管理模式'); return;
    }
    const v = await dlg({ title: '解鎖管理模式', fields: [{ key: 'a', label: '管理密碼', type: 'password', mode: 'numeric', req: true }], validate: v => pinHash(v.a) !== DB.pinHash ? '密碼不對' : '', ok: '解鎖' });
    if (!v) return;
    setAdmin(true); render(); toast('已進入管理模式');
  },
  async changePin() {
    const v = await dlg({ title: '變更管理密碼', fields: [{ key: 'a', label: '新密碼（4～8 位數字）', type: 'password', mode: 'numeric', req: true }, { key: 'b', label: '再輸入一次', type: 'password', mode: 'numeric', req: true }],
      validate: v => !/^\d{4,8}$/.test(v.a) ? '請輸入 4～8 位數字' : v.a !== v.b ? '兩次輸入的密碼不一樣' : '', ok: '變更' });
    if (!v) return;
    DB.pinHash = pinHash(v.a); DB.packDirty = true; save(); render(); toast('已變更，下次匯出的SOP檔會用新密碼');
  },
  async forgotPin() {
    const v = await dlg({ title: '忘記管理密碼', msg: '密碼沒辦法找回，只能清除這支手機的所有資料後重新設定。\n清除前，可以先到每個任務按「複製成文字」把內容存起來，重設後在新任務裡用「貼上文字建立」貼回去。\n確定要清除，請輸入「清除」。',
      fields: [{ key: 'c', label: '輸入「清除」', req: true }], validate: v => v.c !== '清除' ? '請輸入「清除」兩個字' : '', ok: '清除所有資料', danger: true });
    if (!v) return;
    DB = freshDB(); save(); setAdmin(false); location.hash = '#/'; render(); toast('已清除');
  },
  async wipe() {
    const v = await dlg({ title: '清除所有資料？', msg: '這支手機上的SOP、執行紀錄、待審都會刪除，不能復原。建議先下載完整備份。\n確定要清除，請輸入「清除」。',
      fields: [{ key: 'c', label: '輸入「清除」', req: true }], validate: v => v.c !== '清除' ? '請輸入「清除」兩個字' : '', ok: '清除所有資料', danger: true });
    if (!v) return;
    DB = freshDB(); save(); setAdmin(false); location.hash = '#/'; render(); toast('已清除');
  },

  /* SOP檔、備份 */
  async exportPack(a) {
    if (!DB.tasks.length) return alertDlg('還沒有任務', '先建立任務再匯出。');
    const tasks = clone(DB.tasks).map(t => { if (t.dirty || !t.rev) { t.rev = (t.rev || 0) + 1; t.dirty = false; } return t; });
    const at = now();
    const pack = { type: 'sop-pack', schema: 1, app: APP_VER, unit: DB.unit, exportedAt: at, pinHash: DB.pinHash, tasks };
    const r = await shareFile(JSON.stringify(pack), `SOP_${stamp()}.json`, !!(a && a.dataset.dl));
    if (r === 'cancel') return;
    DB.tasks = tasks.map(normTask); DB.lastExport = at; DB.packDirty = false; save(); render();
    toast(r === 'shared' ? '已分享SOP檔' : '已下載SOP檔，把它傳給大家');
  },
  importFile() { const inp = $('#filein'); inp.value = ''; inp.click(); },
  async backup() {
    const at = now();
    const r = await shareFile(JSON.stringify({ type: 'sop-backup', schema: 1, app: APP_VER, exportedAt: at, data: DB }), `SOP_backup_${stamp()}.json`, true);
    if (r === 'cancel') return;
    DB.lastBackup = at; save(); render(); toast('已下載完整備份');
  },

  /* 執行 */
  async startRun(a) {
    const t = getTask(a.dataset.id); if (!t || !flat(t).length) return;
    const ex = DB.runs.find(r => r.taskId === t.id && r.status === 'doing' && r.src === 'local');
    if (ex) {
      const st = runState(ex);
      const c = await choose('這個任務還有一筆沒做完', `${ex.by}，${fmtDT(ex.startAt)} 開始，已處理 ${st.doneN}/${st.total} 項。`, [{ k: 'go', label: '繼續那一筆', cls: 'pri' }, { k: 'new', label: '另外開始新的一筆' }]);
      if (!c) return;
      if (c === 'go') { location.hash = '#/run/' + ex.id; return; }
    }
    const v = await dlg({ title: '開始執行', msg: `${t.name}（${revLabel(t)}，共 ${flat(t).length} 項）\n一次只開放一個項次，做完才能往下，每一步都會記錄時間。`,
      fields: [{ key: 'by', label: '執行人', value: DB.myName, req: true, ph: '例：下士 王小明' }], ok: '開始' });
    if (!v) return;
    const run = { id: uid(), taskId: t.id, taskName: t.name, rev: t.rev, by: v.by, startAt: now(), endAt: 0, status: 'doing', abortReason: '', log: [], reps: [], src: 'local', sent: false };
    DB.runs.unshift(run); DB.myName = v.by; save();
    location.hash = '#/run/' + run.id;
  },
  stepDone(a) {
    const run = getRun(a.dataset.id); if (!run) return;
    const st = runState(run);
    if (!st.cur || st.cur.s.id !== a.dataset.sid) { render(); return; }
    const s = st.cur.s; let val = '';
    if (s.input) {
      const inp = $('#cval'); val = (inp && inp.value || '').trim();
      if (!val) { const e = $('#cerr'); e.textContent = `請先填寫「${s.input}」`; e.hidden = false; inp.focus(); return; }
    }
    run.log.push(val ? { sid: s.id, at: now(), val } : { sid: s.id, at: now() });
    save(); SMOOTH = true; render();
  },
  async stepNA(a) {
    const run = getRun(a.dataset.id); const st = runState(run);
    if (!st.cur || st.cur.s.id !== a.dataset.sid || st.cur.s.key) return;
    const v = await dlg({ title: '這一步不適用？', msg: `「${st.cur.s.title}」\n標成不適用會寫進回報，管理者看得到。`, fields: [{ key: 'r', label: '不適用的原因', multi: true, rows: 2, req: true, ph: '例：今天沒有派車，不用檢查車輛' }],
      validate: v => v.r.length < 2 ? '原因請寫清楚一點' : '', ok: '標成不適用' });
    if (!v) return;
    const st2 = runState(run); if (!st2.cur || st2.cur.s.id !== a.dataset.sid) return render();
    run.log.push({ sid: a.dataset.sid, at: now(), na: v.r }); save(); SMOOTH = true; render();
  },
  stepReport(a) { reportFlow(getRun(a.dataset.id), a.dataset.sid || ''); },
  async undoStep(a) {
    const run = getRun(a.dataset.id); const last = run.log[run.log.length - 1]; if (!last) return;
    const ok = await dlg({ title: '撤回上一步？', msg: `${stepLabel(getTask(run.taskId), last.sid)}\n撤回後要重新按完成，時間會重新記錄。`, ok: '撤回' });
    if (!ok) return;
    run.log.pop(); save(); SMOOTH = true; render();
  },
  peek(a) {
    const run = getRun(a.dataset.id), t = getTask(run.taskId), x = stepInfo(t, a.dataset.sid); if (!x) return;
    let L; L = pushLayer(`<div class="cpath">${cn(x.oi+1)}、${esc(x.o.title)}　（${cn(x.ii+1)}）${esc(x.it.title)}</div><h3>${x.si+1}. ${esc(x.s.title)}${tagsOf(x.s)}</h3>${x.s.desc ? `<div class="cdesc">${nl2br(x.s.desc)}</div>` : ''}${notesBox(x.s.notes, '注意')}<p class="lockmsg">${IC.lock} 還沒輪到這一步，前面的項次完成後才能執行。</p><div class="sbtns"><button class="btn" data-x="cancel">關閉</button></div>`, { cancel: () => popLayer(L) });
  },
  runMenu(a) {
    const run = getRun(a.dataset.id); let L;
    L = pushLayer(`<h3>${esc(run.taskName)}</h3><div class="menu"><button data-x="rep">${IC.warn} 回報狀況（不屬於某一步）</button><button data-x="send">${IC.share} 把目前進度傳給管理者</button><button data-x="sop">${IC.list} 看整份SOP</button><button data-x="abort" class="dangert">${IC.x} 中止任務</button></div><div class="sbtns"><button class="btn" data-x="cancel">關閉</button></div>`, {
      cancel: () => popLayer(L),
      rep: () => { popLayer(L); reportFlow(run, ''); },
      send: () => { popLayer(L); shareText(reportText(run)); },
      sop: () => { popLayer(L); location.hash = '#/t/' + run.taskId; },
      abort: () => { popLayer(L); abortFlow(run); },
    });
  },
  finishRun(a) {
    const run = getRun(a.dataset.id); if (!run || runState(run).cur) return render();
    run.status = 'done'; run.endAt = now(); save(); location.hash = '#/rec/' + run.id;
  },
  abortRun(a) { abortFlow(getRun(a.dataset.id)); },

  /* 回報 */
  async shareRep(a) {
    const run = getRun(a.dataset.id); const r = await shareText(reportText(run));
    if (r === 'cancel') return;
    if (run.status !== 'doing') { run.sent = true; save(); } render();
  },
  async copyRep(a) {
    const run = getRun(a.dataset.id), txt = reportText(run);
    if (await copyText(txt)) { toast('已複製，貼到LINE傳給管理者'); if (run.status !== 'doing') { run.sent = true; save(); } render(); }
    else showTextDlg('回報內容', txt);
  },
  async delRun(a) {
    const ok = await dlg({ title: '刪除這筆紀錄？', msg: '刪除後不能復原。', ok: '刪除', danger: true }); if (!ok) return;
    DB.runs = DB.runs.filter(r => r.id !== a.dataset.id); save(); location.hash = '#/recs';
  },
  async copySop(a) {
    const t = getTask(a.dataset.id), txt = taskToText(t);
    if (await copyText(txt)) toast('已複製整份SOP文字'); else showTextDlg('SOP文字', txt);
  },

  /* 待審 */
  async pasteReports() {
    const v = await dlg({ title: '貼上回報', msg: '把LINE上的回報訊息整則複製貼上（要包含最後「#SOP回報#」開頭的代碼）。可以一次貼很多則。', fields: [{ key: 't', label: '回報內容', multi: true, rows: 8, req: true }], ok: '匯入' });
    if (!v) return;
    const r = importReports(v.t), m = [];
    if (!r.found) m.push('沒有找到回報代碼。請確認有複製到最後「#SOP回報#」開頭的那一段。');
    if (r.added) m.push(`新增 ${r.added} 筆執行紀錄`);
    if (r.updated) m.push(`更新 ${r.updated} 筆執行紀錄`);
    if (r.reps) m.push(`${r.reps} 則臨時狀況放進待審`);
    if (r.dup) m.push(`${r.dup} 則之前已經匯入過`);
    if (r.bad) m.push(`${r.bad} 段代碼讀不出來，可能複製得不完整`);
    render(); await alertDlg('匯入結果', m.join('\n'));
  },
  async pendAdd(a) {
    const p = DB.pending.find(x => x.id === a.dataset.id); if (!p) return;
    const t = getTask(p.taskId); if (!t) return;
    const x = stepInfo(t, p.sid);
    const v = await dlg({ title: '加入注意事項', msg: `加到：${x ? `${x.path} ${x.s.title}` : '整個任務的「執行前注意」'}\n可以先修改文字，讓下一個人一看就懂。`,
      fields: [{ key: 'txt', label: '注意事項', multi: true, rows: 4, req: true, value: p.what + (p.how ? `\n處置：${p.how}` : '') }], ok: '加入' });
    if (!v) return;
    const note = { id: uid(), text: v.txt, by: p.by, at: p.at };
    if (x) x.s.notes.push(note); else t.notes.push(note);
    t.dirty = true; t.updatedAt = now();
    DB.pending = DB.pending.filter(q => q.id !== p.id); save(); render();
    toast('已加入。記得匯出SOP檔發給大家');
  },
  async pendDrop(a) {
    const ok = await dlg({ title: '不採用這則狀況？', msg: '會從待審移除，執行紀錄裡還是看得到。', ok: '不採用' }); if (!ok) return;
    DB.pending = DB.pending.filter(p => p.id !== a.dataset.id); save(); render();
  },

  /* 編輯 */
  async editCancel() {
    if (EDIT && EDIT.dirty) { const ok = await dlg({ title: '放棄修改？', msg: '剛才的修改都不會儲存。', ok: '放棄修改', cancel: '繼續編輯', danger: true }); if (!ok) return; }
    const back = EDIT && !EDIT.isNew ? '#/t/' + EDIT.id : '#/'; EDIT = null; location.hash = back;
  },
  editSave() {
    if (!EDIT) return;
    const d = EDIT.draft; d.name = d.name.trim(); d.cat = d.cat.trim();
    if (!d.name) return alertDlg('請填任務名稱', '');
    for (const x of flat(d)) if (!x.s.title.trim()) return alertDlg('有項次沒有名稱', `${x.path} 還沒填名稱。`);
    d.outlines.forEach(o => { o.title = o.title.trim(); o.items.forEach(i => { i.title = i.title.trim(); }); });
    d.notes = d.notes.filter(n => n.text.trim()).map(n => ({ ...n, text: n.text.trim() }));
    if (EDIT.isNew) { d.rev = 0; d.dirty = true; d.updatedAt = now(); DB.tasks.push(normTask(d)); }
    else {
      const i = DB.tasks.findIndex(t => t.id === d.id), old = DB.tasks[i];
      const sig = t => JSON.stringify([t.name, t.cat, t.purpose, t.notes, t.outlines]);
      if (sig(old) !== sig(d)) { d.dirty = true; d.updatedAt = now(); }
      DB.tasks[i] = normTask(d);
    }
    save(); const id = d.id; EDIT = null; location.hash = '#/t/' + id; toast('已儲存');
  },
  async delTask() {
    const d = EDIT.draft;
    const ok = await dlg({ title: '刪除這個任務？', msg: `「${d.name || '（未命名）'}」會從SOP移除，執行紀錄會保留。\n刪除後要重新匯出SOP檔，大家匯入後才會消失。`, ok: '刪除', danger: true });
    if (!ok) return;
    DB.tasks = DB.tasks.filter(t => t.id !== d.id); DB.packDirty = true; save(); EDIT = null; location.hash = '#/'; toast('已刪除');
  },
  addTNote() { EDIT.draft.notes.push({ id: uid(), text: '', by: '', at: 0 }); EDIT.dirty = true; reEdit(`[data-f="tn.${EDIT.draft.notes.length - 1}"]`); },
  delTNote(a) { EDIT.draft.notes.splice(+a.dataset.i, 1); EDIT.dirty = true; reEdit(); },
  addOutline() { const d = EDIT.draft; d.outlines.push({ id: uid(), title: '', items: [{ id: uid(), title: '', steps: [] }] }); EDIT.dirty = true; reEdit(`[data-f="o.${d.outlines.length - 1}"]`); },
  addItem(a) { const oi = +a.dataset.p, o = EDIT.draft.outlines[oi]; o.items.push({ id: uid(), title: '', steps: [] }); EDIT.dirty = true; reEdit(`[data-f="i.${oi}.${o.items.length - 1}"]`); },
  addStep(a) {
    const [oi, ii] = a.dataset.p.split('.').map(Number), it = EDIT.draft.outlines[oi].items[ii];
    it.steps.push({ id: uid(), title: '', desc: '', input: '', key: false, notes: [] }); EDIT.dirty = true; reEdit();
    openStepEditor(`${oi}.${ii}.${it.steps.length - 1}`, true);
  },
  editStep(a) { openStepEditor(a.dataset.p, false); },
  mv(a) {
    const d = EDIT.draft, dir = +a.dataset.d; let arr, i;
    if (a.dataset.k === 'o') { arr = d.outlines; i = +a.dataset.p; } else { const [oi, ii] = a.dataset.p.split('.').map(Number); arr = d.outlines[oi].items; i = ii; }
    const j = i + dir; if (j < 0 || j >= arr.length) return;
    [arr[i], arr[j]] = [arr[j], arr[i]]; EDIT.dirty = true; reEdit();
  },
  async rm(a) {
    const d = EDIT.draft;
    if (a.dataset.k === 'o') {
      const oi = +a.dataset.p, o = d.outlines[oi], n = o.items.reduce((s, i) => s + i.steps.length, 0);
      if (o.title || n) { const ok = await dlg({ title: '刪除大綱？', msg: `「${cn(oi+1)}、${o.title || '（未命名）'}」${n ? `和底下 ${n} 個項次` : ''}都會刪除。`, ok: '刪除', danger: true }); if (!ok) return; }
      d.outlines.splice(oi, 1);
    } else {
      const [oi, ii] = a.dataset.p.split('.').map(Number), it = d.outlines[oi].items[ii];
      if (it.title || it.steps.length) { const ok = await dlg({ title: '刪除項目？', msg: `「（${cn(ii+1)}）${it.title || '（未命名）'}」${it.steps.length ? `和底下 ${it.steps.length} 個項次` : ''}都會刪除。`, ok: '刪除', danger: true }); if (!ok) return; }
      d.outlines[oi].items.splice(ii, 1);
    }
    EDIT.dirty = true; reEdit();
  },
  async pasteText() {
    const v = await dlg({ title: '貼上文字建立', html: true,
      msg: `每一行開頭用下面的寫法，系統會自動分層：<div class="fmt">一、大綱名稱<br>（一）項目名稱<br>1. 項次名稱<br>說明：怎麼做（很多行就每行都用「說明：」開頭）<br>填寫：完成時要填的結果，例：數量<br>※ 注意事項<br>★ 放在項次名稱前面＝關鍵步驟</div>`,
      fields: [{ key: 't', label: '貼上內容', multi: true, rows: 9, req: true }], ok: '解析' });
    if (!v) return;
    const r = parseOutline(v.t);
    if (!r.steps) return alertDlg('沒有讀到任何項次', '請確認項次是用「1.」「2.」這樣的數字開頭。');
    const d = EDIT.draft, has = d.outlines.length > 0;
    const sum = `讀到 大綱 ${r.outlines.length} 個、項目 ${r.items} 個、項次 ${r.steps} 個${r.notes ? `、注意事項 ${r.notes} 則` : ''}。${r.skipped ? `\n有 ${r.skipped} 行不知道要放哪裡，已略過。` : ''}`;
    const c = await choose('解析結果', sum + (has ? '\n\n要接在目前的大綱後面，還是整個取代？' : ''), has
      ? [{ k: 'append', label: '接在後面', cls: 'pri' }, { k: 'replace', label: '取代目前的大綱', cls: 'dangert' }]
      : [{ k: 'append', label: '套用', cls: 'pri' }]);
    if (!c) return;
    if (c === 'replace') d.outlines = r.outlines; else d.outlines.push(...r.outlines);
    if (!d.name && r.name) d.name = r.name;
    if (!d.purpose && r.purpose) d.purpose = r.purpose;
    d.notes.push(...r.tnotes);
    EDIT.dirty = true; reEdit(); toast('已套用，檢查一下再儲存');
  },
};
async function reportFlow(run, sid) {
  if (!run) return;
  const v = await dlg({ title: '回報狀況', msg: sid ? stepLabel(getTask(run.taskId), sid) : '整個任務',
    fields: [{ key: 'what', label: '發生什麼狀況', multi: true, rows: 3, req: true, ph: '例：滅火器壓力指針在紅區' }, { key: 'how', label: '你怎麼處理（可空白）', multi: true, rows: 2, ph: '例：改用二樓的滅火器，已報告值星官' }], ok: '記錄' });
  if (!v) return;
  const at = now();
  run.reps.push({ id: uid(), sid, what: v.what, how: v.how, at });
  DB.pending.push({ id: uid(), taskId: run.taskId, sid, what: v.what, how: v.how, by: run.by, at, runId: run.id });
  save(); render(); toast('已記錄，會附在這次的回報裡');
}
async function abortFlow(run) {
  if (!run) return;
  const v = await dlg({ title: '中止任務？', msg: '中止後這筆執行就結束了，不能再繼續。中止和原因都會寫進回報。', fields: [{ key: 'r', label: '中止原因', multi: true, rows: 2, req: true }], ok: '中止任務', danger: true });
  if (!v) return;
  run.status = 'abort'; run.abortReason = v.r; run.endAt = now(); save(); location.hash = '#/rec/' + run.id;
}

/* ---------- 匯入檔案 ---------- */
async function handleFile(text) {
  let o;
  try { o = JSON.parse(String(text).replace(/^﻿/, '')); } catch (e) { return alertDlg('看不懂這個檔案', '請選管理者傳來的「SOP_日期.json」，或之前下載的備份檔。'); }
  if (o && o.type === 'sop-pack' && Array.isArray(o.tasks)) {
    const pending = ADMIN && unpublished() && DB.tasks.length;
    const ok = await dlg({ title: '匯入SOP檔', msg: `${o.unit ? o.unit + '，' : ''}${fmtDT(o.exportedAt)} 匯出，共 ${o.tasks.length} 個任務。\n這支手機上的SOP會換成這份，執行紀錄會保留。${pending ? '\n\n注意：你有還沒匯出的修改，匯入後會被蓋掉。' : ''}`, ok: '匯入' });
    if (!ok) return;
    DB.tasks = o.tasks.map(normTask);
    if (o.unit) DB.unit = String(o.unit);
    if (o.pinHash && o.pinHash !== DB.pinHash) { DB.pinHash = String(o.pinHash); setAdmin(false); }
    DB.packInfo = { exportedAt: +o.exportedAt || now(), importedAt: now() }; DB.packDirty = false;
    save(); EDIT = null; location.hash = '#/'; render(); toast(`已匯入 ${o.tasks.length} 個任務`);
    return;
  }
  if (o && o.type === 'sop-backup' && o.data) {
    const ok = await dlg({ title: '還原備份？', msg: `${fmtDT(o.exportedAt)} 的備份。\n這支手機目前的所有資料（SOP、執行紀錄、待審）都會換成備份裡的內容。`, ok: '還原', danger: true });
    if (!ok) return;
    DB = Object.assign(freshDB(), o.data); DB.tasks = (DB.tasks || []).map(normTask);
    setAdmin(false); save(); EDIT = null; location.hash = '#/'; render(); toast('已還原備份');
    return;
  }
  alertDlg('看不懂這個檔案', '這不是SOP檔，也不是備份檔。');
}

/* ---------- 路由 ---------- */
function route() { const p = (location.hash.slice(1) || '/').split('/').filter(Boolean); return { name: p[0] || 'home', id: p[1] || '' }; }
function render() {
  if (TIMER) { clearInterval(TIMER); TIMER = null; }
  const r = route(); let h = '', after = null;
  switch (r.name) {
    case 't': h = vTask(r.id); break;
    case 'run': h = vRun(r.id); after = () => afterRun(r.id); break;
    case 'rec': h = vRec(r.id); break;
    case 'recs': h = vRecs(r.id); break;
    case 'review': h = ADMIN ? vReview() : vHome(); break;
    case 'edit': h = ADMIN ? vEdit(r.id) : vHome(); break;
    case 'set': h = vSet(); break;
    default: h = vHome();
  }
  $('#app').innerHTML = h; document.body.dataset.view = r.name;
  if (after) after();
}
function onHash() {
  const r = route();
  if (EDIT && EDIT.dirty && r.name !== 'edit') {
    if (!confirm('編輯的內容還沒儲存，確定要離開嗎？')) { location.hash = '#/edit/' + EDIT.id; return; }
  }
  if (r.name !== 'edit') EDIT = null;
  closeAllLayers(); window.scrollTo(0, 0); render();
}

/* ---------- 啟動 ---------- */
const APP = $('#app');
APP.addEventListener('click', e => { const a = e.target.closest('[data-act]'); if (!a || a.disabled) return; const f = ACT[a.dataset.act]; if (!f) return; e.preventDefault(); f(a, e); });
APP.addEventListener('input', e => { const t = e.target; if (t.dataset.f !== undefined) editInput(t); else if (t.id === 'q') filterTasks(t.value); else if (t.dataset.set) settingsInput(t); });
APP.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.id === 'cval') { e.preventDefault(); e.target.blur(); } });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && LAYERS.length) { const L = LAYERS[LAYERS.length - 1]; if (L.handlers.cancel) L.handlers.cancel(); } });
$('#filein').addEventListener('change', e => {
  const f = e.target.files && e.target.files[0]; if (!f) return;
  const rd = new FileReader();
  rd.onload = () => handleFile(rd.result);
  rd.onerror = () => alertDlg('讀取失敗', '檔案讀不出來，請重新選一次。');
  rd.readAsText(f);
});
window.addEventListener('hashchange', onHash);
render();
</script>
</body>
</html>

