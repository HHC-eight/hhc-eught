  }
  h += '<h2 class="sh">逐項紀錄</h2>';
  if (!run.log.length) h += '<p class="hint">還沒有完成任何項次。</p>';
  else {
    h += '<div class="list">';
    let prev = run.startAt;
    [...run.log].sort((a, b) => a.at - b.at).forEach(l => {
      const gap = l.at - prev, isFast = !l.na && gap < FAST_MS; prev = l.at;
      h += `<div class="tli${l.na ? ' na' : ''}"><span class="mk">${l.na ? IC.na : IC.check}</span><div class="tlb"><div class="tlt">${esc(stepLabel(t, l.sid))}</div>${l.val ? `<div class="tlv">填寫：${esc(l.val)}</div>` : ''}${l.na ? `<div class="tlv">不適用：${esc(l.na)}</div>` : ''}</div><div class="tlm"><div>${fmtTS(l.at)}</div><div class="${isFast ? 'fast' : ''}">+${fmtGap(gap)}</div></div></div>`;
