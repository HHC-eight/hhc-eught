/* ---------- 執行中 ---------- */
function pbar(st) {
  if (!st.total || st.total > 60) { const p = st.total ? Math.round(st.doneN / st.total * 100) : 0; return `<div class="pb1"><i style="width:${p}%"></i></div>`; }
  return `<div class="pb">${st.f.map(x => { const l = st.lm.get(x.s.id); return `<i class="${l ? (l.na ? 'n' : 'd') : (st.cur && st.cur.s.id === x.s.id ? 'c' : '')}"></i>`; }).join('')}</div>`;
}
function curCard(run, x, k, total) {
  const s = x.s, reps = run.reps.filter(r => r.sid === s.id);
  return `<div class="cur" id="cur">
    <div class="cpath">${cn(x.oi+1)}、${esc(x.o.title)}　（${cn(x.ii+1)}）${esc(x.it.title)}</div>
    <div class="chead"><span class="cnum">${x.si+1}</span><h2 class="ctit">${esc(s.title)}</h2></div>
    ${s.key || s.input ? `<div class="ctags">${tagsOf(s)}</div>` : ''}
    ${s.desc ? `<div class="cdesc">${nl2br(s.desc)}</div>` : ''}
    ${notesBox(s.notes, '注意（之前遇過的狀況）')}
    ${reps.length ? `<div class="myrep"><b>這次回報的狀況</b>${reps.map(r => `<div>${nl2br(r.what)}${r.how ? `<br><span>處置：${nl2br(r.how)}</span>` : ''}</div>`).join('')}</div>` : ''}
    ${s.input ? `<label class="cin">${esc(s.input)}<input id="cval" type="text" autocomplete="off" enterkeyhint="done" placeholder="填了才能按完成"></label><div class="cerr" id="cerr" hidden></div>` : ''}
    <button class="btn pri big" data-act="stepDone" data-id="${run.id}" data-sid="${s.id}">${IC.check} 完成這一步</button>
    <div class="crow"><button class="btn warnb" data-act="stepReport" data-id="${run.id}" data-sid="${s.id}">${IC.warn} 回報狀況</button><button class="btn" data-act="stepNA" data-id="${run.id}" data-sid="${s.id}" ${s.key ? 'disabled' : ''}>${IC.na} 不適用</button></div>
    ${s.key ? '<div class="khint">關鍵步驟：一定要做，不能標不適用。</div>' : ''}
    <div class="cidx">第 ${k+1} 項，共 ${total} 項</div>
  </div>`;
}
function vRun(id) {
  const run = getRun(id); if (!run) return notFound('找不到這筆執行');
  if (run.status !== 'doing') { setTimeout(() => location.replace('#/rec/' + id)); return ''; }
  const st = runState(run), t = st.task;
  const prog = `<div class="prog"><div class="pc"><b>${st.doneN}</b> / ${st.total}</div>${pbar(st)}</div>`;
  let h = topBar({ title: run.taskName, subHtml: `${esc(run.by)}　已進行 <span id="elapsed">${fmtClock(now() - run.startAt)}</span>`, back: '#/', right: `<button class="ib" data-act="runMenu" data-id="${run.id}" aria-label="更多選項">${IC.more}</button>`, extra: prog, noAdmin: true });
  h += '<main class="wrap">';
  if (!t) return h + `<div class="empty"><h2>這個任務已不在目前的SOP裡</h2><p>可能管理者更新了SOP。這筆執行可以中止。</p><div class="btns"><button class="btn" data-act="abortRun" data-id="${run.id}">中止這筆執行</button></div></div></main>`;
  h += notesBox(t.notes, '執行前注意');
  const last = run.log.length ? run.log[run.log.length - 1] : null;
  let co = -1, ci = -1;
  st.f.forEach((x, k) => {
    if (x.oi !== co) { co = x.oi; ci = -1; h += `<div class="rh1">${cn(x.oi+1)}、${esc(x.o.title)}</div>`; }
    if (x.ii !== ci) { ci = x.ii; h += `<div class="rh2">（${cn(x.ii+1)}）${esc(x.it.title)}</div>`; }
    const l = st.lm.get(x.s.id);
    if (l) {
      h += `<div class="row done${l.na ? ' na' : ''}"><span class="mk">${l.na ? IC.na : IC.check}</span><span class="rn">${x.si+1}.</span><span class="rt">${esc(x.s.title)}${l.val ? `<span class="rv">${esc(x.s.input || '結果')}：${esc(l.val)}</span>` : ''}${l.na ? `<span class="rv">不適用：${esc(l.na)}</span>` : ''}</span><span class="rtime">${fmtT(l.at)}</span>${last && last.sid === x.s.id ? `<button class="undo" data-act="undoStep" data-id="${run.id}">撤回</button>` : ''}</div>`;
    } else if (st.cur && st.cur.s.id === x.s.id) {
      h += curCard(run, x, k, st.total);
    } else {
      h += `<button class="row lock" data-act="peek" data-id="${run.id}" data-sid="${x.s.id}"><span class="mk">${IC.lock}</span><span class="rn">${x.si+1}.</span><span class="rt">${esc(x.s.title)}</span></button>`;
    }
  });
  if (!st.cur && st.total) {
    const c = runCounts(run);
    h += `<div class="fin" id="cur"><h2>所有項次都處理完了</h2><p>完成 ${c.ok} 項${c.na ? `，不適用 ${c.na} 項` : ''}${c.rep ? `，回報狀況 ${c.rep} 則` : ''}。</p><p>按下面的按鈕結束任務，然後把回報傳給管理者。</p><div class="btns"><button class="btn pri big" data-act="finishRun" data-id="${run.id}">結束任務</button></div></div>`;
  }
  return h + '</main>';
}
let TIMER = null, SMOOTH = false;
const RM = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
function afterRun(id) {
  const run = getRun(id); if (!run || run.status !== 'doing') return;
  const el = $('#elapsed'); if (el) TIMER = setInterval(() => { el.textContent = fmtClock(now() - run.startAt); }, 1000);
  const c = $('#cur'), smooth = SMOOTH; SMOOTH = false;
  if (!c) return;
