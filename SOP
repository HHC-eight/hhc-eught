    h += '</div>';
  }
  if (run.reps.length) {
    h += '<h2 class="sh">臨時狀況</h2><div class="list">';
    run.reps.forEach(r => { h += `<div class="repi"><div class="tlt">${esc(stepLabel(t, r.sid))}</div><div>狀況：${nl2br(r.what)}</div>${r.how ? `<div>處置：${nl2br(r.how)}</div>` : ''}<span class="nby">${fmtTS(r.at)}</span></div>`; });
