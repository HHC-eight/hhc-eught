}

/* ---------- SOP全文 ---------- */
function vTask(id) {
  const t = getTask(id); if (!t) return notFound('找不到這個任務', '可能已被刪除，或SOP已更新。');
  const f = flat(t), nRec = DB.runs.filter(r => r.taskId === t.id).length;
  const sub = [t.cat, revLabel(t) + (ADMIN && t.dirty && t.rev ? '（有修改未發佈）' : ''), f.length + ' 項次'].filter(Boolean).join('　');
  let h = topBar({ title: t.name, sub, back: '#/', right: ADMIN ? `<a class="ib" href="#/edit/${t.id}" aria-label="編輯">${IC.pencil}</a>` : '' });
  h += '<main class="wrap">';
  if (t.purpose) h += `<p class="purpose">${nl2br(t.purpose)}</p>`;
  h += notesBox(t.notes, '執行前注意');
  if (!f.length) h += `<div class="empty"><p>這個任務還沒有項次。${ADMIN ? '按右上角的筆來新增。' : ''}</p></div>`;
  t.outlines.forEach((o, oi) => {
    h += `<h2 class="vh1">${cn(oi+1)}、${esc(o.title || '（未命名大綱）')}</h2>`;
    o.items.forEach((it, ii) => {
      h += `<h3 class="vh2">（${cn(ii+1)}）${esc(it.title || '（未命名項目）')}</h3>`;
      it.steps.forEach((s, si) => {
        h += `<div class="vst"><div class="n">${si+1}</div><div><div class="t">${esc(s.title)}${tagsOf(s)}</div>${s.desc ? `<div class="d">${nl2br(s.desc)}</div>` : ''}${notesBox(s.notes)}</div></div>`;
      });
