  h += `<div class="vfoot"><a class="lnk" href="#/recs/${t.id}">執行紀錄 ${nRec} 筆</a><button class="lnk" data-act="copySop" data-id="${t.id}">複製成文字</button></div></main>`;
  h += `<div class="dock"><button class="btn pri big" data-act="startRun" data-id="${t.id}" ${f.length ? '' : 'disabled'}>${IC.play} 開始執行</button></div>`;
