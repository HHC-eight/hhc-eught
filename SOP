function vReview() {
  let h = topBar({ title: '待審的狀況', right: GEAR }) + '<main class="wrap">';
  h += `<button class="btn pri wide" data-act="pasteReports">${IC.inbox} 貼上大家傳來的回報</button><p class="hint">在LINE長按回報訊息、複製，貼到這裡（要包含最後那段代碼）。可以一次貼好幾則。</p>`;
  if (!DB.pending.length) h += '<div class="empty"><p>目前沒有待審的狀況。執行的人回報臨時狀況後，會出現在這裡，由你決定要不要加進SOP。</p></div>';
  else {
    const by = new Map(); DB.pending.forEach(p => { if (!by.has(p.taskId)) by.set(p.taskId, []); by.get(p.taskId).push(p); });
    by.forEach((list, tid) => {
      const t = getTask(tid);
      h += `<h2 class="gh">${esc(t ? t.name : '（已刪除的任務）')}</h2><div class="list">`;
      list.forEach(p => {
        h += `<div class="pend"><div class="tlt">${esc(stepLabel(t, p.sid))}</div><div>狀況：${nl2br(p.what)}</div>${p.how ? `<div>處置：${nl2br(p.how)}</div>` : ''}<span class="nby">${esc(p.by)}　${fmtDT(p.at)}</span><div class="btns2"><button class="btn pri sm" data-act="pendAdd" data-id="${p.id}" ${t ? '' : 'disabled'}>加入注意事項</button><button class="btn sm" data-act="pendDrop" data-id="${p.id}">不採用</button></div></div>`;
      });
      h += '</div>';
    });
  }
  return h + '</main>' + tabs('review');
}

/* ---------- 編輯任務（管理者） ---------- */
let EDIT = null;
function mvBtns(kind, p, i, len) {
  return `<span class="mv"><button class="ib sm" data-act="mv" data-k="${kind}" data-p="${p}" data-d="-1" ${i === 0 ? 'disabled' : ''} aria-label="上移">${IC.up}</button><button class="ib sm" data-act="mv" data-k="${kind}" data-p="${p}" data-d="1" ${i === len - 1 ? 'disabled' : ''} aria-label="下移">${IC.down}</button><button class="ib sm" data-act="rm" data-k="${kind}" data-p="${p}" aria-label="刪除">${IC.x}</button></span>`;
}
function vEdit(id) {
  if (!EDIT || EDIT.id !== id) {
    const t = id === 'new' ? null : getTask(id);
    if (id !== 'new' && !t) return notFound('找不到這個任務');
    EDIT = { id, isNew: !t, dirty: false, draft: t ? clone(t) : { id: uid(), name: '', cat: '', purpose: '', notes: [], outlines: [], rev: 0, dirty: true, updatedAt: 0 } };
  }
  const d = EDIT.draft;
  let h = topBar({ title: EDIT.isNew ? '新增任務' : '編輯任務', left: '<button class="tb" data-act="editCancel">取消</button>', right: '<button class="tb pri" data-act="editSave">儲存</button>', noAdmin: true });
  h += '<main class="wrap">';
  h += `<label class="fl">任務名稱<input data-f="name" value="${esc(d.name)}" placeholder="例：營區火災應變" autocomplete="off"></label>`;
  h += `<label class="fl">分類（可空白）<input data-f="cat" value="${esc(d.cat)}" list="catlist" placeholder="例：勤務、行政、戰備" autocomplete="off"></label><datalist id="catlist">${[...new Set(DB.tasks.map(t => t.cat).filter(Boolean))].map(c => `<option value="${esc(c)}">`).join('')}</datalist>`;
  h += `<label class="fl">任務目的或說明（可空白）<textarea data-f="purpose" rows="2">${esc(d.purpose)}</textarea></label>`;
  h += `<div class="edh">執行前注意（整個任務）</div>${d.notes.map((n, i) => `<div class="ednote"><textarea data-f="tn.${i}" rows="2">${esc(n.text)}</textarea><button class="ib sm" data-act="delTNote" data-i="${i}" aria-label="刪除">${IC.x}</button></div>`).join('')}<button class="add" data-act="addTNote">${IC.plus} 新增執行前注意</button>`;
  h += `<div class="edh">大綱、項目、項次</div><div class="edtool"><button class="btn sm" data-act="pasteText">${IC.paste} 貼上文字建立</button></div>`;
  d.outlines.forEach((o, oi) => {
    h += `<section class="eo"><div class="eoh"><span class="cnl">${cn(oi+1)}、</span><input data-f="o.${oi}" value="${esc(o.title)}" placeholder="大綱名稱" autocomplete="off">${mvBtns('o', oi, oi, d.outlines.length)}</div>`;
    o.items.forEach((it, ii) => {
      h += `<div class="ei"><div class="eih"><span class="cnl">（${cn(ii+1)}）</span><input data-f="i.${oi}.${ii}" value="${esc(it.title)}" placeholder="項目名稱" autocomplete="off">${mvBtns('i', `${oi}.${ii}`, ii, o.items.length)}</div>`;
      it.steps.forEach((s, si) => {
        h += `<button class="es" data-act="editStep" data-p="${oi}.${ii}.${si}"><span class="esn">${si+1}.</span><span class="est">${s.title ? esc(s.title) : '<em>（還沒填名稱）</em>'}${tagsOf(s)}${s.notes.length ? `<span class="tag wn">注意 ${s.notes.length}</span>` : ''}</span>${IC.chev}</button>`;
      });
      h += `<button class="add" data-act="addStep" data-p="${oi}.${ii}">${IC.plus} 新增項次</button></div>`;
    });
    h += `<button class="add" data-act="addItem" data-p="${oi}">${IC.plus} 新增項目</button></section>`;
  });
  h += `<button class="btn wide" data-act="addOutline">${IC.plus} 新增大綱</button>`;
  if (!EDIT.isNew) h += `<div class="btns"><button class="lnk dangert" data-act="delTask">刪除這個任務</button></div>`;
  return h + '</main>';
}
function editInput(el) {
  if (!EDIT) return;
  const d = EDIT.draft, p = el.dataset.f.split('.'), v = el.value;
  if (p[0] === 'name') d.name = v;
  else if (p[0] === 'cat') d.cat = v;
  else if (p[0] === 'purpose') d.purpose = v;
  else if (p[0] === 'tn') d.notes[+p[1]].text = v;
  else if (p[0] === 'o') d.outlines[+p[1]].title = v;
  else if (p[0] === 'i') d.outlines[+p[1]].items[+p[2]].title = v;
  EDIT.dirty = true;
}
function reEdit(focusSel) {
  const y = window.scrollY; render(); window.scrollTo(0, y);
  if (focusSel) { const el = $(focusSel); if (el) { el.focus(); el.scrollIntoView({ block: 'center' }); } }
}
function openStepEditor(p, isNew) {
  const [oi, ii, si] = p.split('.').map(Number), d = EDIT.draft, o = d.outlines[oi], it = o.items[ii];
  const tmp = clone(it.steps[si]); tmp.inOn = !!tmp.input;
  let L;
  const body = () => `<div class="cpath">${cn(oi+1)}、${esc(o.title)}　（${cn(ii+1)}）${esc(it.title)}</div><h3>第 ${si+1} 項次</h3>
    <label class="fl">項次名稱<input id="s_t" value="${esc(tmp.title)}" placeholder="要做的動作，例：大喊「失火了」" autocomplete="off"></label>
    <label class="fl">說明<textarea id="s_d" rows="4" placeholder="怎麼做、做到什麼程度、找誰">${esc(tmp.desc)}</textarea></label>
    <label class="ck"><input type="checkbox" id="s_k" ${tmp.key ? 'checked' : ''}><span><b>關鍵步驟</b>：執行時不能標「不適用」</span></label>
    <label class="ck"><input type="checkbox" id="s_ion" ${tmp.inOn ? 'checked' : ''}><span><b>完成時要填寫結果</b>：沒填就不能按完成</span></label>
    <input id="s_i" class="${tmp.inOn ? '' : 'hide'}" value="${esc(tmp.input)}" placeholder="要填什麼？例：滅火器數量、車號" autocomplete="off">
    <div class="edh">注意事項</div>
    ${tmp.notes.map((n, i) => `<div class="ednote"><textarea data-ni="${i}" rows="2">${esc(n.text)}</textarea><button class="ib sm" data-x="delN" data-i="${i}" aria-label="刪除">${IC.x}</button></div>`).join('')}
    <button class="add" data-x="addN">${IC.plus} 新增注意事項</button>
    <div class="smv"><button class="btn sm" data-x="up" ${si === 0 ? 'disabled' : ''}>${IC.up} 上移</button><button class="btn sm" data-x="down" ${si === it.steps.length - 1 ? 'disabled' : ''}>${IC.down} 下移</button><button class="btn sm dangert" data-x="del">刪除項次</button></div>
    <div class="err" hidden></div>
    <div class="sbtns"><button class="btn" data-x="cancel">取消</button><button class="btn pri" data-x="ok">完成</button></div>`;
  const q = s => L.el.querySelector(s);
  const collect = () => {
    tmp.title = q('#s_t').value; tmp.desc = q('#s_d').value; tmp.key = q('#s_k').checked; tmp.inOn = q('#s_ion').checked; tmp.input = q('#s_i').value;
    L.el.querySelectorAll('[data-ni]').forEach(ta => { tmp.notes[+ta.dataset.ni].text = ta.value; });
  };
  const redraw = () => { q('.sheet').innerHTML = body(); };
  const valid = () => { if (tmp.title.trim()) return true; const e = q('.err'); e.textContent = '請填項次名稱'; e.hidden = false; q('#s_t').focus(); return false; };
  const commit = () => {
    it.steps[si] = { id: tmp.id, title: tmp.title.trim(), desc: tmp.desc.replace(/\s+$/, ''), key: !!tmp.key, input: tmp.inOn ? (tmp.input.trim() || '結果') : '',
      notes: tmp.notes.filter(n => n.text.trim()).map(n => ({ ...n, text: n.text.trim() })) };
    EDIT.dirty = true;
  };
  const move = dir => { collect(); if (!valid()) return; commit(); const j = si + dir; if (j >= 0 && j < it.steps.length) [it.steps[si], it.steps[j]] = [it.steps[j], it.steps[si]]; popLayer(L); reEdit(); };
  L = pushLayer(body(), {
    cancel() { if (isNew) it.steps.splice(si, 1); popLayer(L); reEdit(); },
    ok() { collect(); if (!valid()) return; commit(); popLayer(L); reEdit(); },
    addN() { collect(); tmp.notes.push({ id: uid(), text: '', by: '', at: 0 }); redraw(); const all = L.el.querySelectorAll('[data-ni]'); if (all.length) all[all.length - 1].focus(); },
    delN(b) { collect(); tmp.notes.splice(+b.dataset.i, 1); redraw(); },
    up() { move(-1); }, down() { move(1); },
    async del() { const ok = await dlg({ title: '刪除這個項次？', msg: tmp.title || '（還沒填名稱）', ok: '刪除', danger: true }); if (!ok) return; it.steps.splice(si, 1); EDIT.dirty = true; popLayer(L); reEdit(); }
  });
  L.el.addEventListener('change', e => { if (e.target.id === 's_ion') { q('#s_i').classList.toggle('hide', !e.target.checked); if (e.target.checked) q('#s_i').focus(); } });
  if (isNew) setTimeout(() => { const el = q('#s_t'); if (el) el.focus(); }, 60);
}

