<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="任務SOP">
<meta name="theme-color" content="#4A5A2E">
<title>任務SOP</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&display=swap" media="print" onload="this.media='all'">
<style>
/* 任務SOP系統 v1 —— 色票：營舍灰綠底、草綠(OD)主色、警示琥珀、關鍵紅 */
:root{
  --field:#E5E9E2;--paper:#FFFFFF;--ink:#1E2A21;--muted:#56625A;--rule:#C9D1C6;--rule2:#E0E5DD;
  --od:#4A5A2E;--od-ink:#FFFFFF;--od-soft:#E2E9D4;
  --amber:#875800;--amber-bg:#FCEFCD;--amber-line:#E2AE38;
  --red:#B3261E;--lock:#939C93;
  --num:"Barlow Condensed","Arial Narrow",system-ui,sans-serif;
  --sans:-apple-system,BlinkMacSystemFont,"PingFang TC","Noto Sans TC","Microsoft JhengHei","Heiti TC",system-ui,sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root{--field:#101410;--paper:#1A201A;--ink:#E3E9DF;--muted:#9DA89D;--rule:#343D34;--rule2:#262D26;
    --od:#88A45A;--od-ink:#0E120B;--od-soft:#26321F;
    --amber:#F1C451;--amber-bg:#352B12;--amber-line:#9C7720;
    --red:#FF8A80;--lock:#5F6A5F;color-scheme:dark}
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%;background:var(--field)}
body{margin:0;min-height:100vh;background:var(--field);color:var(--ink);font:16px/1.6 var(--sans);-webkit-tap-highlight-color:transparent}
body.noscroll{overflow:hidden}
a{color:inherit}
h1,h2,h3{line-height:1.35}
button{font:inherit;color:inherit;cursor:pointer}
button:disabled{cursor:not-allowed}
input:not([type=checkbox]),textarea{display:block;width:100%;padding:10px 11px;font:inherit;font-size:16px;color:var(--ink);background:var(--paper);border:1px solid var(--rule);border-radius:4px;-webkit-appearance:none;appearance:none}
textarea{resize:vertical;line-height:1.55}
input:focus,textarea:focus{outline:2px solid var(--od);outline-offset:-1px;border-color:var(--od)}
:focus-visible{outline:2px solid var(--od);outline-offset:2px}
.ic{width:22px;height:22px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-5px}
.ic.sm{width:17px;height:17px;vertical-align:-3px}
.wrap{max-width:680px;margin:0 auto;padding:14px 16px calc(104px + env(safe-area-inset-bottom))}

/* 頂部列 */
.top{position:sticky;top:0;z-index:30;background:var(--paper);border-bottom:1px solid var(--rule);padding-top:env(safe-area-inset-top)}
.bar{display:flex;align-items:center;gap:2px;min-height:54px;padding:4px 6px;max-width:700px;margin:0 auto}
.bar .tt{flex:1;min-width:0;padding:0 6px}
.bar .tt.pad{padding-left:12px}
.bar h1{margin:0;font-size:18px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar .ts{font-size:13px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ib{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;flex:none;border:0;border-radius:6px;background:none;color:var(--ink);text-decoration:none}
.ib:active{background:var(--rule2)}
.ib.sm{width:34px;height:34px}
.ib:disabled{opacity:.25}
.tb{flex:none;border:0;background:none;padding:8px 12px;border-radius:6px;font-size:16px;color:var(--muted)}
.tb.pri{color:var(--od);font-weight:700}
.abar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:5px 16px;background:var(--amber-bg);color:var(--amber);border-top:1px solid var(--amber-line);font-size:14px;font-weight:600}
.abar span{display:flex;align-items:center;gap:6px}
.abar button{border:1px solid var(--amber-line);background:var(--paper);color:var(--amber);border-radius:4px;padding:2px 12px;font-size:13px;font-weight:600}

/* 底部分頁 */
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;background:var(--paper);border-top:1px solid var(--rule);padding-bottom:env(safe-area-inset-bottom)}
.tabs a{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;gap:1px;padding:8px 0 6px;font-size:12px;color:var(--muted);text-decoration:none}
.tabs a.on{color:var(--od);font-weight:700}
.tabs a.on::before{content:"";position:absolute;top:-1px;left:32%;right:32%;height:3px;background:var(--od)}
.bdg{display:inline-block;min-width:18px;margin-left:3px;padding:0 5px;border-radius:9px;background:var(--red);color:#fff;font-style:normal;font-size:11px;line-height:18px;text-align:center}

/* 按鈕 */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:46px;padding:8px 16px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);color:var(--ink);font-size:16px;font-weight:600;text-decoration:none;line-height:1.3;text-align:center}
.btn:active{transform:translateY(1px)}
.btn.pri{background:var(--od);border-color:var(--od);color:var(--od-ink)}
.btn.big{display:flex;width:100%;min-height:58px;font-size:19px;font-weight:700}
.btn.wide{display:flex;width:100%;margin-top:12px}
.btn.sm{min-height:38px;padding:6px 12px;font-size:15px}
.btn.danger{background:var(--red);border-color:var(--red);color:#fff}
.btn.warnb{color:var(--amber);border-color:var(--amber-line);background:var(--amber-bg)}
.btn:disabled{opacity:.38}
.dangert{color:var(--red)!important}
.lnk{border:0;background:none;padding:8px 0;color:var(--od);font-size:15px;font-weight:600;text-decoration:underline;text-underline-offset:3px}
.btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
.btns2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.add{display:flex;align-items:center;gap:6px;width:100%;margin-top:8px;padding:10px 12px;border:1px dashed var(--rule);border-radius:6px;background:none;color:var(--od);font-size:15px;font-weight:600}
.hint{margin:6px 0;font-size:14px;color:var(--muted)}

/* 首頁 */
.doing{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:12px 14px;border-radius:6px;background:var(--od);color:var(--od-ink);text-decoration:none}
.doing .dg{display:flex;flex-direction:column;line-height:1.4}
.doing .dg span{font-size:14px;opacity:.9}
.pub{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;padding:12px 14px;border:1px solid var(--amber-line);border-radius:6px;background:var(--amber-bg)}
.pub b{display:block;color:var(--amber)}
.pub span{font-size:14px;color:var(--muted)}
.pub .btn{flex:none}
.search{margin-bottom:6px}
.gh{margin:18px 2px 6px;font-size:14px;font-weight:700;color:var(--muted)}
.list{background:var(--paper);border:1px solid var(--rule);border-radius:6px}
.list>*{border-top:1px solid var(--rule2)}
.list>:first-child{border-top:0}
.trow{display:block;padding:13px 14px;text-decoration:none}
.tn{display:block;font-size:17px;font-weight:700;line-height:1.4}
.tm{display:flex;flex-wrap:wrap;gap:2px 14px;margin-top:2px;font-size:13px;color:var(--muted)}
.wn{color:var(--amber);font-weight:600}
.empty{padding:20px 18px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.empty h2{margin:0 0 8px;font-size:19px}
.empty p{margin:6px 0;color:var(--muted)}
.empty p b{color:var(--ink)}

/* SOP全文 */
.purpose{margin:2px 0 12px;color:var(--muted)}
.vh1{margin:24px 0 2px;padding-bottom:5px;border-bottom:2px solid var(--ink);font-size:18px}
.vh2{margin:14px 0 2px;font-size:16px}
.vst{display:grid;grid-template-columns:28px 1fr;gap:0 10px;padding:10px 0;border-bottom:1px solid var(--rule2)}
.vst .n{font-family:var(--num);font-weight:700;font-size:24px;line-height:1.1;color:var(--od);text-align:right}
.vst .t{font-weight:600;line-height:1.45}
.vst .d{margin-top:3px;font-size:15px;color:var(--muted)}
.vfoot{display:flex;justify-content:space-between;align-items:center;margin-top:18px}
.dock{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:var(--paper);border-top:1px solid var(--rule)}
.dock .btn{max-width:648px;margin:0 auto}

/* 標籤、注意事項 */
.tag{display:inline-block;margin-left:6px;padding:0 6px;border:1px solid currentColor;border-radius:3px;font-size:12px;font-weight:700;line-height:18px;vertical-align:2px;white-space:nowrap}
.tag.key{color:var(--red)}
.tag.inp{color:var(--od)}
.tag.wn{color:var(--amber)}
.note{margin-top:8px;padding:8px 10px 8px 12px;border-left:4px solid var(--amber-line);border-radius:0 4px 4px 0;background:var(--amber-bg);font-size:15px}
.note>b{display:flex;align-items:center;gap:5px;margin-bottom:2px;font-size:14px;color:var(--amber)}
.note .ni+.ni{margin-top:6px;padding-top:6px;border-top:1px dashed var(--amber-line)}
.nby{display:block;font-size:12px;color:var(--muted)}

/* 執行中 */
.prog{display:flex;align-items:center;gap:12px;max-width:700px;margin:0 auto;padding:0 16px 10px}
.pc{flex:none;font-family:var(--num);font-size:16px;color:var(--muted);white-space:nowrap}
.pc b{font-size:28px;font-weight:700;color:var(--ink)}
.pb{flex:1;display:flex;gap:2px;height:10px}
.pb i{flex:1;border-radius:1px;background:var(--rule2)}
.pb i.d{background:var(--od)}
.pb i.n{background:var(--amber-line)}
.pb i.c{background:var(--ink)}
.pb1{flex:1;height:10px;overflow:hidden;border-radius:2px;background:var(--rule2)}
.pb1 i{display:block;height:100%;background:var(--od)}
.rh1{margin:22px 0 0;padding-bottom:4px;border-bottom:2px solid var(--ink);font-size:16px;font-weight:700}
.rh2{margin:10px 0 0;font-size:14px;font-weight:700;color:var(--muted)}
.row{display:flex;align-items:baseline;gap:8px;width:100%;padding:9px 2px;border:0;border-bottom:1px solid var(--rule2);background:none;text-align:left;font-size:15px;line-height:1.45}
.row .mk{flex:none;align-self:center;display:flex}
.row .rn{flex:none;min-width:20px;font-family:var(--num);font-size:17px;font-weight:700}
.row .rt{flex:1;min-width:0}
.row .rv{display:block;font-size:13px}
.row .rtime{flex:none;font-family:var(--num);font-size:15px}
.row.done{color:var(--muted)}
.row.done .mk,.row.done .rn{color:var(--od)}
.row.na .mk,.row.na .rn{color:var(--amber)}
.row.lock{color:var(--lock)}
.undo{flex:none;padding:2px 8px;border:1px solid var(--rule);border-radius:4px;background:var(--paper);color:var(--muted);font-size:13px}
.cur{margin:10px -6px 12px;padding:14px 14px 12px 16px;border:2px solid var(--ink);border-left:9px solid var(--od);border-radius:6px;background:var(--paper);scroll-margin-top:calc(152px + env(safe-area-inset-top))}
.cpath{font-size:13px;font-weight:600;color:var(--muted)}
.chead{display:flex;align-items:flex-start;gap:12px;margin-top:4px}
.cnum{flex:none;min-width:28px;font-family:var(--num);font-size:50px;font-weight:700;line-height:.95;color:var(--od)}
.ctit{margin:0;padding-top:4px;font-size:22px;font-weight:700}
.ctags{margin:8px 0 0 -6px}
.cdesc{margin-top:10px;font-size:17px;line-height:1.65}
.myrep{margin-top:8px;padding:8px 10px;border:1px dashed var(--amber-line);border-radius:4px;font-size:15px}
.myrep b{display:block;font-size:13px;color:var(--amber)}
.myrep span{color:var(--muted)}
.cin{display:block;margin-top:14px;font-size:15px;font-weight:700}
.cin input{margin-top:4px;font-weight:400}
.cerr,.err{margin-top:6px;font-size:14px;font-weight:600;color:var(--red)}
.cur .btn.big{margin-top:14px}
.crow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.khint{margin-top:8px;font-size:13px;color:var(--red)}
.cidx{margin-top:10px;font-size:13px;color:var(--muted);text-align:right}
.cur.cool .btn{pointer-events:none}
.cur.arrive{animation:arrive .55s ease-out}
@keyframes arrive{from{background:var(--od-soft)}to{background:var(--paper)}}
.fin{margin:18px 0;padding:18px 16px;border:2px solid var(--od);border-radius:6px;background:var(--paper);scroll-margin-top:calc(152px + env(safe-area-inset-top))}
.fin h2{margin:0 0 6px;font-size:20px}
.fin p{margin:0 0 4px;color:var(--muted)}

/* 紀錄 */
.rsum{padding:12px 14px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.chip{display:inline-block;margin-right:6px;padding:1px 8px;border-radius:3px;font-size:13px;font-weight:700;line-height:20px;white-space:nowrap}
.chip.done{background:var(--od);color:var(--od-ink)}
.chip.abort{background:var(--red);color:#fff}
.chip.doing{background:var(--ink);color:var(--paper)}
.chip.imp{border:1px solid var(--rule);color:var(--muted)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:10px 0 0}
.kv dt{font-size:14px;color:var(--muted)}
.kv dd{margin:0;font-size:15px}
.sendbox{margin-top:12px}
.sendbox.need{padding:12px;border:2px solid var(--amber-line);border-radius:6px;background:var(--amber-bg)}
.sendbox.need>b{color:var(--amber)}
.sh{margin:22px 0 6px;font-size:16px}
.tli{display:flex;gap:10px;padding:9px 12px;font-size:15px}
.tli .mk{flex:none;padding-top:1px;color:var(--od)}
.tli.na .mk{color:var(--amber)}
.tlb{flex:1;min-width:0}
.tlt{font-weight:600}
.tlv{font-size:14px;color:var(--muted)}
.tlm{flex:none;font-family:var(--num);font-size:15px;line-height:1.35;color:var(--muted);text-align:right}
.tlm .fast{font-weight:700;color:var(--amber)}
.repi,.pend{padding:10px 12px;font-size:15px}
.rrow{display:block;padding:11px 14px;text-decoration:none}
.rrow .r1{display:flex;align-items:center;justify-content:space-between;gap:8px}
.rrow .r2{display:block;font-size:13px;color:var(--muted)}
.rrow .r3{display:flex;flex-wrap:wrap;gap:2px 12px;font-size:13px;color:var(--muted)}
.rrow .alert{font-weight:700;color:var(--red)}

/* 設定 */
.ss{margin-bottom:12px;padding:14px;border:1px solid var(--rule);border-radius:6px;background:var(--paper)}
.ss h2{margin:0 0 4px;font-size:16px}
.ss>.btn{margin-top:8px}
.about{border:0;background:none}

/* 編輯 */
.fl{display:block;margin-bottom:12px;font-size:14px;font-weight:700;color:var(--muted)}
.fl input,.fl textarea{margin-top:4px;font-weight:400}
.edh{margin:12px 0 4px;font-size:14px;font-weight:700;color:var(--muted)}
.ednote{display:flex;align-items:flex-start;gap:6px;margin-bottom:6px}
.edtool{margin:4px 0 6px}
.eo{margin-top:14px;padding:10px;border:1px solid var(--rule);border-top:3px solid var(--ink);border-radius:6px;background:var(--paper)}
.eoh,.eih{display:flex;align-items:center;gap:4px}
.eoh input{font-weight:700}
.cnl{flex:none;min-width:30px;font-weight:700}
.mv{display:flex;flex:none}
.ei{margin:10px 0 0 4px;padding-left:10px;border-left:2px solid var(--rule)}
.es{display:flex;align-items:center;gap:8px;width:100%;padding:10px 4px;border:0;border-bottom:1px solid var(--rule2);background:none;text-align:left}
.esn{min-width:22px;font-family:var(--num);font-size:18px;font-weight:700;color:var(--od)}
.est{flex:1;min-width:0}
.est em{font-style:normal;color:var(--red)}

/* 對話框 */
#modal .layer{position:fixed;inset:0;z-index:100}
.layer .ov{position:absolute;inset:0;background:rgba(12,16,12,.5);opacity:0;transition:opacity .15s}
.layer .sheet{position:absolute;left:10px;right:10px;top:calc(env(safe-area-inset-top) + 12px);max-width:560px;max-height:calc(100vh - 24px);max-height:calc(100dvh - 24px - env(safe-area-inset-top));margin:0 auto;padding:18px 16px 16px;overflow:auto;-webkit-overflow-scrolling:touch;border-radius:10px;background:var(--paper);box-shadow:0 12px 40px rgba(0,0,0,.28);opacity:0;transform:translateY(-8px);transition:transform .16s,opacity .16s}
.layer.in .ov{opacity:1}
.layer.in .sheet{opacity:1;transform:none}
.sheet h3{margin:0 0 8px;font-size:19px}
.sheet .msg{margin-bottom:12px;font-size:15px;color:var(--muted)}
.sbtns{display:flex;gap:10px;margin-top:14px}
.sbtns .btn{flex:1}
.chs{display:flex;flex-direction:column;gap:8px;margin-top:12px}
.menu{display:flex;flex-direction:column;margin:4px -16px 0}
.menu button{display:flex;align-items:center;gap:10px;padding:14px 18px;border:0;border-top:1px solid var(--rule2);background:none;text-align:left;font-size:16px}
.ck{display:flex;align-items:flex-start;gap:10px;padding:8px 0;font-size:15px}
.ck input{flex:none;width:22px;height:22px;margin:1px 0 0;accent-color:var(--od)}
.hide{display:none}
.smv{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.fmt{padding:10px 12px;border-radius:4px;background:var(--field);color:var(--ink);font-size:14px;line-height:1.8}
.lockmsg{display:flex;align-items:center;gap:6px;font-size:14px;color:var(--muted)}
#toast{position:fixed;left:50%;bottom:calc(86px + env(safe-area-inset-bottom));z-index:200;max-width:90vw;padding:10px 16px;border-radius:6px;background:var(--ink);color:var(--paper);font-size:15px;opacity:0;pointer-events:none;transform:translateX(-50%);transition:opacity .2s}
#toast.on{opacity:1}
@media (prefers-reduced-motion:reduce){.layer .ov,.layer .sheet,#toast{transition:none}.cur.arrive{animation:none}}
</style>
</head>
<body>
<div id="app"></div>
<div id="modal"></div>
<div id="toast" role="status" aria-live="polite"></div>
<input type="file" id="filein" hidden>
<noscript>這個系統需要開啟 JavaScript 才能使用。</noscript>
<script>
'use strict';
/* ============================================================
   任務SOP系統 v1
   結構：任務 → 大綱（一、）→ 項目（（一））→ 項次（1.）＋說明
   資料存在本機 localStorage（key: hhcSop_v1，不會碰到同網域的其他系統）
   ============================================================ */
const APP_VER = 'v1';
const LS_KEY = 'hhcSop_v1';
const SALT = 'hhc-sop';
const FAST_MS = 5000;   // 與上一項間隔少於這個毫秒數，回報裡會標出來

/* ---------- 小工具 ---------- */
const $ = (s, el = document) => el.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nl2br = s => esc(s).replace(/\n/g, '<br>');
const uid = () => Date.now().toString(36).slice(-4) + Math.random().toString(36).slice(2, 6);
const now = () => Date.now();
const clone = o => JSON.parse(JSON.stringify(o));
const p2 = n => String(n).padStart(2, '0');
const WD = '日一二三四五六', CNN = '零一二三四五六七八九';
function cn(n) {
  if (n < 1) return String(n);
  if (n < 10) return CNN[n];
  if (n === 10) return '十';
  if (n < 20) return '十' + CNN[n - 10];
  if (n < 100) { const t = Math.floor(n / 10), u = n % 10; return CNN[t] + '十' + (u ? CNN[u] : ''); }
  return String(n);
}
function fmtDT(t) { const d = new Date(t); return `${d.getMonth()+1}/${d.getDate()}(${WD[d.getDay()]}) ${p2(d.getHours())}:${p2(d.getMinutes())}`; }
function fmtD(t) { const d = new Date(t); return `${d.getMonth()+1}/${d.getDate()}`; }
function fmtT(t) { const d = new Date(t); return `${p2(d.getHours())}:${p2(d.getMinutes())}`; }
