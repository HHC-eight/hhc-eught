  const ta = L.el.querySelector('textarea'); setTimeout(() => { ta.focus(); ta.select(); }, 80);
}
let TT;
function toast(m) { const el = $('#toast'); el.textContent = m; el.classList.add('on'); clearTimeout(TT); TT = setTimeout(() => el.classList.remove('on'), 2400); }

/* ---------- 分享、複製、檔案 ---------- */
async function copyText(t) {
  try { if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(t); return true; } } catch (e) {}
  const ta = document.createElement('textarea'); ta.value = t; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
  document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0, t.length);
  let ok = false; try { ok = document.execCommand('copy'); } catch (e) {}
  ta.remove(); return ok;
}
async function shareText(t, title) {
  if (navigator.share) { try { await navigator.share({ text: t }); return 'shared'; } catch (e) { if (e && e.name === 'AbortError') return 'cancel'; } }
  if (await copyText(t)) { toast('已複製，貼到LINE傳出去'); return 'copied'; }
  showTextDlg(title || '回報內容', t); return 'manual';
}
async function shareFile(content, name, dlOnly) {
  const blob = new Blob([content], { type: 'application/json' });
  if (!dlOnly && navigator.canShare && typeof File === 'function') {
    // 有些手機的分享選單不收 .json，就改用 .txt（內容一樣，匯入時都讀得懂）
    for (const [n, ty] of [[name, 'application/json'], [name.replace(/\.json$/, '.txt'), 'text/plain']]) {
      try {
        const file = new File([content], n, { type: ty });
        if (navigator.canShare({ files: [file] })) { await navigator.share({ files: [file] }); return 'shared'; }
      } catch (e) { if (e && e.name === 'AbortError') return 'cancel'; break; }
    }
  }
  const url = URL.createObjectURL(blob), a = document.createElement('a');
  a.href = url; a.download = name; document.body.appendChild(a); a.click();
  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 3000);
  return 'downloaded';
}

