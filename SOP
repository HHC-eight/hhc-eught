  else h += `<div class="btns2"><button class="btn" data-act="lock">${IC.lock} 鎖定</button><button class="btn" data-act="changePin">變更管理密碼</button></div>`;
  h += '</section>';
  h += `<section class="ss"><h2>備份</h2><p class="hint">資料只存在這支手機的瀏覽器裡。${DB.lastBackup ? `上次備份：${fmtDT(DB.lastBackup)}。` : '還沒備份過。'}換手機或清除瀏覽器資料前，先下載完整備份。</p><button class="btn" data-act="backup">${IC.download} 下載完整備份</button></section>`;
