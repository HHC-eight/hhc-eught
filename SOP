    <dt>SOP</dt><dd>${run.rev ? `第${run.rev}版` : '未發佈版'}${t && t.rev && t.rev !== run.rev ? `（目前是第${t.rev}版）` : ''}</dd>
    <dt>結果</dt><dd>完成 ${c.ok} 項${c.na ? `，不適用 ${c.na} 項` : ''}${remain > 0 ? `，未處理 ${remain} 項` : ''}${c.rep ? `，狀況 ${c.rep} 則` : ''}</dd>
